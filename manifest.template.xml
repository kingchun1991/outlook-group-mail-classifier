<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0" xmlns:mailappor="http://schemas.microsoft.com/office/mailappversion/1.1" xsi:type="MailApp">
  <Id>5f4ed7c4-6c95-4f4b-9f90-5a6ac53fdd21</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Outlook Group Mail Classifier</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Group Mail Classifier"/>
  <Description DefaultValue="Classify Outlook messages by recipient domains and organize them."/>
  <IconUrl DefaultValue="{{BASE_URL}}/assets/icon32.svg"/>
  <HighResolutionIconUrl DefaultValue="{{BASE_URL}}/assets/icon80.svg"/>
  <SupportUrl DefaultValue="https://github.com/kingchun1991/outlook-group-mail-classifier"/>
  <AppDomains><AppDomain>{{BASE_URL}}</AppDomain></AppDomains>
  <Hosts><Host Name="Mailbox"/></Hosts>
  <Requirements><Sets><Set Name="Mailbox" MinVersion="1.5"/></Sets></Requirements>
  <FormSettings>
    <Form xsi:type="ItemRead"><DesktopSettings><SourceLocation DefaultValue="{{BASE_URL}}/taskpane.html"/><RequestedHeight>450</RequestedHeight></DesktopSettings></Form>
    <Form xsi:type="ItemEdit"><DesktopSettings><SourceLocation DefaultValue="{{BASE_URL}}/taskpane.html"/><RequestedHeight>450</RequestedHeight></DesktopSettings></Form>
  </FormSettings>
  <Permissions>ReadWriteMailbox</Permissions>
  <Rule xsi:type="RuleCollection" Mode="And"><Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/></Rule>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversion" xsi:type="VersionOverridesV1_0">
    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversion/1.1" xsi:type="VersionOverridesV1_1">
      <Description resid="residDescription"/>
      <Requirements><bt:Sets DefaultMinVersion="1.5"><bt:Set Name="Mailbox"/></bt:Sets></Requirements>
      <Hosts><Host xsi:type="MailHost">
        <DesktopFormFactor>
          <FunctionFile resid="functionFile"/>
          <ExtensionPoint xsi:type="MessageReadCommandSurface"><OfficeTab id="TabDefault"><Group id="classifierGroup"><Label resid="groupLabel"/><Control xsi:type="Button" id="classifyButton"><Label resid="classifyLabel"/><Supertip><Title resid="classifyLabel"/><Description resid="classifyDescription"/></Supertip><Icon><bt:Image size="16" resid="icon16"/><bt:Image size="32" resid="icon32"/><bt:Image size="80" resid="icon80"/></Icon><Action xsi:type="ShowTaskpane"><SourceLocation resid="taskpaneUrl"/></Action></Control></Group></OfficeTab></ExtensionPoint>
          <ExtensionPoint xsi:type="Events"><Event Type="ItemSend" FunctionExecution="onItemSend"/></ExtensionPoint>
        </DesktopFormFactor>
      </Host></Hosts>
      <Resources>
        <bt:Images><bt:Image id="icon16" DefaultValue="{{BASE_URL}}/assets/icon16.svg"/><bt:Image id="icon32" DefaultValue="{{BASE_URL}}/assets/icon32.svg"/><bt:Image id="icon80" DefaultValue="{{BASE_URL}}/assets/icon80.svg"/></bt:Images>
        <bt:Urls><bt:Url id="functionFile" DefaultValue="{{BASE_URL}}/commands.html"/><bt:Url id="taskpaneUrl" DefaultValue="{{BASE_URL}}/taskpane.html"/></bt:Urls>
        <bt:ShortStrings><bt:String id="groupLabel" DefaultValue="Mail Classifier"/><bt:String id="classifyLabel" DefaultValue="Classify message"/></bt:ShortStrings>
        <bt:LongStrings><bt:String id="residDescription" DefaultValue="Classify and organize group mail."/><bt:String id="classifyDescription" DefaultValue="Open the classifier task pane."/></bt:LongStrings>
      </Resources>
    </VersionOverrides>
  </VersionOverrides>
</OfficeApp>
